test <- map(entry, fmt_authors_card)
test <- map(entry, fmt_authors_card)
fmt_authors_card <- function(entry) {
au <- entry$author
if (is.null(au) || length(au) == 0) return(NA_character_)
fmt_one <- function(a) {
given <- a$given %||% ""
family <- a$family %||% ""
full_name <- paste(given, family)
trimws(full_name)
}
pieces <- vapply(au, fmt_one, character(1))
pieces <- pieces[nzchar(pieces)]
if (!length(pieces)) return(NA_character_)
if (length(pieces) == 1) return(pieces[1])
return(paste(paste(pieces[-length(pieces)], collapse = ", "), "&", pieces[length(pieces)]))
}
test <- map(entry, fmt_authors_card)
