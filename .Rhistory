# Keep only the school years both sources cover (2011/12 to 2023/24)
filter(between(Year, as.Date("2012-07-01"), as.Date("2024-07-01"))) |>
group_by(Year, Category, `School Lanuage`) |>
summarise(Number=sum(Number)) |>
group_by(Year) |>
mutate(Category_percent=Number/sum(Number)*100) |>
ungroup()->ontario_school_enrollment_language
#| label:
private_school_enrollment |>
bind_rows(public_school_enrollment_type) |>
# Keep only the school years both sources cover (2011/12 to 2023/24)
filter(between(Year, as.Date("2012-07-01"), as.Date("2024-07-01"))) |>
group_by(Year, Category, `School Language`) |>
summarise(Number=sum(Number)) |>
group_by(Year) |>
mutate(Category_percent=Number/sum(Number)*100) |>
ungroup()->ontario_school_enrollment_language
#| label:
ontario_school_enrollment_language
#| label:
ontario_school_enrollment_language |>
mutate(Category=paste(Category, `School Language`))
#| label:
ontario_school_enrollment_language |>
mutate(Category=paste(Category, `School Language`)) |>
mutate(Category=str_remove_all(Category, " NA"))
# Combine the board names and language for comparison
ontario_school_enrollment_language |>
mutate(Category=paste(Category, `School Language`)) |>
mutate(Category=str_remove_all(Category, " NA"))->ontario_school_enrollment_language
#| label:
ontario_school_enrollment_language |>
ggplot(aes(x=Year, y=Category_percent))+geom_col()+facet_wrap(~fct_relevel(Category,"Public English", "Catholic English", "Public French", "Catholic French", "Private"))
#| label:
ontario_school_enrollment_language |>
ggplot(aes(x=Year, y=Category_percent))+geom_col()+facet_wrap(~fct_relevel(Category,"Public English", "Catholic English", "Public French", "Catholic French", "Private"))+theme_minimal()
#| label:
ontario_school_enrollment_language |>
filter(str_detect(Category, "Protestant", negate=T)) |>
ggplot(aes(x=Year, y=Category_percent))+geom_col()+facet_wrap(~fct_relevel(Category,"Public English", "Catholic English", "Public French", "Catholic French", "Private"))+theme_minimal()
#| label:
ontario_school_enrollment_language |>
filter(str_detect(Category, "Protestant", negate=T)) |>
ggplot(aes(x=Year, y=Category_percent))+geom_col()+facet_wrap(~fct_relevel(Category,"Public English", "Catholic English", "Public French", "Catholic French", "Private"))+theme_minimal()+geom_text(aes(x=Year, y=Category_percent+1, label=round(Category_percent,1)), size=2)
#| label:
ontario_school_enrollment_language |>
filter(str_detect(Category, "Protestant", negate=T)) |>
ggplot(aes(x=Year, y=Category_percent))+geom_col()+facet_wrap(~fct_relevel(Category,"Public English", "Catholic English", "Public French", "Catholic French", "Private"))+theme_minimal()+geom_text(aes(x=Year, y=Category_percent+2, label=round(Category_percent,1)), size=2)
#| label: setup
library(tidyverse)
library(here)
#| label: fig-plot-language
#| fig.width: 7
#| fig.height: 5
#| fig.cap: "Distribution of Ontario school enrollment by board and language of instruction (Kindergarten to Grade 12). Source: Statistics Canada Table 37-10-0173 for private school and Ontario Open Data catalogue for all others."
ontario_school_enrollment_language |>
filter(str_detect(Category, "Protestant", negate=T)) |>
# Label each bar with its school year, e.g. 2024-07-01 -> "2023-24"
mutate(`School Year`=paste0(year(Year)-1, "-", str_sub(year(Year), 3, 4))) |>
ggplot(aes(x=`School Year`, y=Category_percent))+geom_col()+facet_wrap(~fct_relevel(Category,"Public English", "Catholic English",  "Private","Public French", "Catholic French"), scales="free_x")+theme_minimal()+geom_text(aes(x=`School Year`, y=Category_percent+2, label=round(Category_percent,1)), size=2)+
labs(x=NULL, y="Percent")+
theme(axis.text.x=element_text(angle=90, vjust=0.5, hjust=1, size=7))
