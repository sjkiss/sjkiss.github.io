#| label: setup
library(tidyverse)
library(here)
#| label: load-cansim
install.packages("cansim")
library(cansim)
search_cansim_cubes("Number of students")
#| label: get-private-school-enrollment
private_school_enrollment<-get_cansim("37-10-0173")
private_school_enrollment
private_school_enrollment |>
filter(GEO=="Ontario") |> filter(str_detect(Grade, "Total")) |>
filter(str_detect(Sex, "Total")) |>
select(Year=Date, Number=VALUE) |>
mutate(Category=rep("Private", n()))->private_school_enrollment
#| label: scrape-public-school-enrollment
library(jsonlite)
library(readxl)
# List every file in the Ontario Open Data "Ontario public schools enrolment" dataset
# (https://data.ontario.ca/dataset/ontario-public-schools-enrolment)
# and keep the English Excel table for each academic year
ontario_enrolment_resources<-fromJSON("https://data.ontario.ca/api/3/action/package_show?id=ontario-public-schools-enrolment")$result$resources |>
filter(format=="XLSX", language=="english") |>
mutate(`Academic Year`=str_extract(name, "\\d{4}-\\d{4}")) |>
select(`Academic Year`, url) |>
arrange(`Academic Year`)
# Download each year once, then read and stack them. Every year has the same
# columns: Board Number, Board Name, School Number, School Name, School Level,
# School Type, School Language, Enrolment
enrolment_dir<-here("posts/2026-10-07-trends-in-public-school-enrolment-in-ontario/data")
dir.create(enrolment_dir, showWarnings=FALSE)
read_enrolment_year<-function(year, url) {
file<-file.path(enrolment_dir, basename(url))
if (!file.exists(file)) download.file(url, file, mode="wb", quiet=TRUE)
read_excel(file, sheet=1, col_types="text") |>
mutate(`Academic Year`=year)
}
map2(ontario_enrolment_resources$`Academic Year`, ontario_enrolment_resources$url, read_enrolment_year) |>
list_rbind() |>
# Drop the provincial total row at the bottom of each sheet
filter(!is.na(`School Number`)) |>
# Schools with fewer than 10 students are reported as "<10"; set them to 5
mutate(Enrolment=if_else(Enrolment=="<10", 5, parse_number(Enrolment)),
`School Type`=recode(`School Type`, "Roman Catholic"="Catholic"))->public_school_enrollment_by_school
#| label: mutate-public-school-enrollment
#head(public_school_enrollment_by_school)
public_school_enrollment_by_school |>
group_by(`School Type`, `School Language`, `Academic Year`) |>
summarise(Number=sum(Enrolment)) |>
# Keep the year the school year ends (2023-2024 -> 2024), which is how
# cansim dates StatCan's school years (2023/2024 -> 2024-07-01)
separate_wider_delim(`Academic Year`, delim="-", names=c("Start Year", "Year"), cols_remove=T)->public_school_enrollment_type
#Turn Year into Date
public_school_enrollment_type |>
mutate(Year=as.Date(paste(Year, "-07-01", sep=""))) |>
rename(Category=`School Type`)->public_school_enrollment_type
#| label: combine
private_school_enrollment |>
bind_rows(public_school_enrollment_type) |>
# Keep only the school years both sources cover (2011/12 to 2023/24)
filter(between(Year, as.Date("2012-07-01"), as.Date("2024-07-01"))) |>
group_by(Year, Category) |>
summarise(Number=sum(Number), .groups="drop") |>
group_by(Year) |>
mutate(Category_percent=Number/sum(Number)*100) |>
ungroup()->ontario_school_enrollment
#| label: draw-plot
ontario_school_enrollment |>
filter(str_detect(Category, "Protestant", negate=T)) |>
ggplot(aes(x=Year, y=Number, fill=`Category`))+geom_col(position="dodge")
#| label: draw-plot
ontario_school_enrollment |>
filter(str_detect(Category, "Protestant", negate=T)) |>
ggplot(aes(x=Year, y=Category_percent, fill=`Category`))+geom_col()
#| label: draw-plot
ontario_school_enrollment |>
filter(str_detect(Category, "Protestant", negate=T)) |>
ggplot(aes(x=Year, y=Category_percent))+geom_col()+facet_grid(~Category)+annotate(geom="text", aes(x=Year, y=Category_percent+15, label=Category_percent))
#| label: draw-plot
ontario_school_enrollment |>
filter(str_detect(Category, "Protestant", negate=T)) |>
ggplot(aes(x=Year, y=Category_percent))+geom_col()+facet_grid(~Category)
ggplot(aes(x=Year, y=Category_percent))+geom_col()+facet_grid(~fct_relevel(Category, "Public", "Catholic", "Private")
#| label: draw-plot
ontario_school_enrollment |>
#| label: draw-plot
ontario_school_enrollment |>
filter(str_detect(Category, "Protestant", negate=T)) |>
ggplot(aes(x=Year, y=Category_percent))+geom_col()+facet_grid(~fct_relevel(Category, "Public", "Catholic", "Private"))
#| label: draw-plot
ontario_school_enrollment |>
filter(str_detect(Category, "Protestant", negate=T)) |>
ggplot(aes(x=Year, y=Category_percent))+geom_col()+facet_grid(~fct_relevel(Category, "Public", "Catholic", "Private"))+theme_minimal
#| label: draw-plot
ontario_school_enrollment |>
filter(str_detect(Category, "Protestant", negate=T)) |>
ggplot(aes(x=Year, y=Category_percent))+geom_col()+facet_grid(~fct_relevel(Category, "Public", "Catholic", "Private"))+theme_minimal()
?annotate
?geom_label()
#| label: draw-plot
ontario_school_enrollment |>
filter(str_detect(Category, "Protestant", negate=T)) |>
ggplot(aes(x=Year, y=Category_percent))+geom_col()+facet_grid(~fct_relevel(Category, "Public", "Catholic", "Private"))+theme_minimal()+geom_text(aes(x=Year, y=Category_percent+15, label=Category_percent))
#| label: draw-plot
ontario_school_enrollment |>
filter(str_detect(Category, "Protestant", negate=T)) |>
ggplot(aes(x=Year, y=Category_percent))+geom_col()+facet_grid(~fct_relevel(Category, "Public", "Catholic", "Private"))+theme_minimal()+geom_text(aes(x=Year, y=Category_percent+5, label=Category_percent), size=6)
#| label: draw-plot
ontario_school_enrollment |>
filter(str_detect(Category, "Protestant", negate=T)) |>
ggplot(aes(x=Year, y=Category_percent))+geom_col()+facet_grid(~fct_relevel(Category, "Public", "Catholic", "Private"))+theme_minimal()+geom_text(aes(x=Year, y=Category_percent+5, label=Category_percent), size="6pt")
#| label: draw-plot
ontario_school_enrollment |>
filter(str_detect(Category, "Protestant", negate=T)) |>
ggplot(aes(x=Year, y=Category_percent))+geom_col()+facet_grid(~fct_relevel(Category, "Public", "Catholic", "Private"))+theme_minimal()+geom_text(aes(x=Year, y=Category_percent+5, label=Category_percent), size=0.5)
#| label: draw-plot
ontario_school_enrollment |>
filter(str_detect(Category, "Protestant", negate=T)) |>
ggplot(aes(x=Year, y=Category_percent))+geom_col()+facet_grid(~fct_relevel(Category, "Public", "Catholic", "Private"))+theme_minimal()+geom_text(aes(x=Year, y=Category_percent+5, label=Category_percent), size=1)
#| label: draw-plot
ontario_school_enrollment |>
filter(str_detect(Category, "Protestant", negate=T)) |>
ggplot(aes(x=Year, y=Category_percent))+geom_col()+facet_grid(~fct_relevel(Category, "Public", "Catholic", "Private"))+theme_minimal()+geom_text(aes(x=Year, y=Category_percent+5, label=round(Category_percent,0)), size=1)
#| label: draw-plot
ontario_school_enrollment |>
filter(str_detect(Category, "Protestant", negate=T)) |>
ggplot(aes(x=Year, y=Category_percent))+geom_col()+facet_grid(~fct_relevel(Category, "Public", "Catholic", "Private"))+theme_minimal()+geom_text(aes(x=Year, y=Category_percent+5, label=round(Category_percent,0)), size=2)
#| label: draw-plot
ontario_school_enrollment |>
filter(str_detect(Category, "Protestant", negate=T)) |>
ggplot(aes(x=Year, y=Category_percent))+geom_col()+facet_grid(~fct_relevel(Category, "Public", "Catholic", "Private"))+theme_minimal()+geom_text(aes(x=Year, y=Category_percent+1, label=round(Category_percent,0)), size=2)
#| label: draw-plot
ontario_school_enrollment |>
filter(str_detect(Category, "Protestant", negate=T)) |>
ggplot(aes(x=Year, y=Category_percent))+geom_col()+facet_grid(~fct_relevel(Category, "Public", "Catholic", "Private"))+theme_minimal()+geom_text(aes(x=Year, y=Category_percent+1, label=round(Category_percent,1)), size=2)
